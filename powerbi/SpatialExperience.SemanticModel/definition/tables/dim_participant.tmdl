		lineageTag: fdb6c986-4f7c-556f-bc7c-55bd7ed2a971
		summarizeBy: none
		sourceColumn: age_group_order

	partition dim_participant = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_participant.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"participant_id", type text}, {"source_id", type text}, {"age_group", type text}, {"gender", type text}, {"academic_group", type text}, {"vr_experience", type number}, {"age_group_order", Int64.Type}}, "en-US")
				in
				    Typed
