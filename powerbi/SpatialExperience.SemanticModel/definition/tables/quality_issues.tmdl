table quality_issues
	lineageTag: 7634ee93-4cf1-52fc-8fd3-420ad43c4f62

	column source_id
		dataType: string
		lineageTag: fdfd7c2d-6c52-52a7-9046-2c628d5e836b
		summarizeBy: none
		sourceColumn: source_id

	column issue_no
		dataType: int64
		lineageTag: 204238c7-db60-56fe-8fc0-e1366ac8a84f
		summarizeBy: none
		sourceColumn: issue_no

	column issue
		dataType: string
		lineageTag: 92329765-66cc-587a-9e27-bcc6b8889a35
		summarizeBy: none
		sourceColumn: issue

	partition quality_issues = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "quality_issues.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"source_id", type text}, {"issue_no", Int64.Type}, {"issue", type text}}, "en-US")
				in
				    Typed
